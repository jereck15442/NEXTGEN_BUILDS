PORT=4000
# MongoDB Atlas connection string (direct — SRV lookup may be blocked by local DNS resolver)
# Replace with your own Atlas direct connection string. Do not commit real credentials.
MONGODB_URI=mongodb://<user>:<password>@<shard1>:27017,<shard2>:27017,<shard3>:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority
# Connection string used by the MongoDB MCP Server (see .mcp.json).
MDB_MCP_CONNECTION_STRING=mongodb://<user>:<password>@<shard1>:27017,<shard2>:27017,<shard3>:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Maya Checkout sandbox. Public key authenticates checkout creation.
# Secret key is only needed for Maya webhook-management APIs, never for checkout.
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_API_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_REDIRECT_URL_SUCCESS=http://localhost:4000/api/v1/payments/return/success
MAYA_REDIRECT_URL_FAILURE=http://localhost:4000/api/v1/payments/return/failure
MAYA_REDIRECT_URL_CANCEL=http://localhost:4000/api/v1/payments/return/cancel
# Maya does not sign webhooks. Requests are accepted only from these addresses in production.
MAYA_WEBHOOK_IP_ALLOWLIST=13.229.160.234,3.1.199.75
MAYA_HTTP_TIMEOUT_MS=10000
# Enable only when running behind a reverse proxy you control, otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=false
